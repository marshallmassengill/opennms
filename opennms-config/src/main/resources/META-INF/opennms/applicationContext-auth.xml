<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:onmsgi="http://xmlns.opennms.org/xsd/spring/onms-osgi"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.2.xsd
        http://xmlns.opennms.org/xsd/spring/onms-osgi http://xmlns.opennms.org/xsd/spring/onms-osgi.xsd">

    <!--
      Wires the runtime side of the dynamic-auth feature.

      AuthConfigFactory is a static-singleton-style factory; TokenProviderImpl
      handles its lazy init internally so a clean install without
      etc/auth-configuration.xml degrades to "no auth definitions, every
      ${auth:...} placeholder falls through" rather than failing at startup.
    -->

    <!--
      TokenAcquirer is constructed without an EntityScopeProvider; the
      provider is bound by TokenAcquirerScopeBinder below if one is on
      the classpath, and skipped otherwise (degraded mode, SCV and env
      scopes only). This keeps applicationContext-auth.xml loadable
      both with and without core/mate/model.

      Setter rather than constructor injection because the production
      EntityScopeProviderImpl autowires the TokenProvider service to
      back AuthScope, and TokenProvider depends back on
      TokenCache+TokenAcquirer, closing a cycle. Setter injection
      lets Spring build TokenAcquirer first and bind the provider
      after the rest of the chain has been constructed.
    -->
    <bean id="authTokenAcquirer"
          class="org.opennms.netmgt.config.auth.TokenAcquirer"/>

    <bean id="authTokenAcquirerScopeBinder"
          class="org.opennms.netmgt.config.auth.TokenAcquirerScopeBinder">
        <constructor-arg ref="authTokenAcquirer"/>
    </bean>

    <bean id="authTokenCache"
          class="org.opennms.netmgt.config.auth.TokenCache">
        <constructor-arg ref="authTokenAcquirer"/>
    </bean>

    <bean id="authTokenProvider"
          class="org.opennms.netmgt.config.auth.TokenProviderImpl">
        <constructor-arg ref="authTokenCache"/>
    </bean>

    <!--
      Expose the TokenProvider as an OSGi service so consumers in other
      bundles (notably any future cross-collector use of ${auth:...})
      can autowire it without depending on opennms-config directly.
    -->
    <onmsgi:service interface="org.opennms.core.mate.api.TokenProvider"
                    ref="authTokenProvider"/>

    <!--
      Reload listener: reacts to a reloadDaemonConfig event with
      daemonName=AuthConfig by re-reading auth-configuration.xml and
      flushing the token cache.

      Self-registers with EventIpcManager via Spring's ContextRefreshedEvent
      once eventDaemonContext has finished building. daoContext is built
      before eventDaemonContext, so we cannot grab the manager up-front.
    -->
    <bean id="authConfigReloadListener"
          class="org.opennms.netmgt.config.auth.AuthConfigReloadListener">
        <constructor-arg ref="authTokenCache"/>
    </bean>
</beans>
