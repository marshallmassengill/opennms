<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.2.xsd">

    <!-- Mock beans for ad-hoc poll and service silence REST endpoint tests -->
    <bean id="rateLimitedAdhocPollService" class="org.mockito.Mockito" factory-method="mock">
        <constructor-arg value="org.opennms.netmgt.poller.RateLimitedAdhocPollService"/>
    </bean>

    <bean id="serviceSilenceService" class="org.mockito.Mockito" factory-method="mock">
        <constructor-arg value="org.opennms.netmgt.poller.ServiceSilenceService"/>
    </bean>

</beans>
