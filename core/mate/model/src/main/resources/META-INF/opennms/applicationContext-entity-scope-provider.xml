<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:onmsgi="http://xmlns.opennms.org/xsd/spring/onms-osgi"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-4.2.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context-4.2.xsd
           http://xmlns.opennms.org/xsd/spring/onms-osgi http://xmlns.opennms.org/xsd/spring/onms-osgi.xsd
        ">

    <context:annotation-config />

    <bean name="entityScopeProvider" class="org.opennms.core.mate.model.EntityScopeProviderImpl" primary="true"/>

    <onmsgi:service ref="entityScopeProvider" interface="org.opennms.core.mate.api.EntityScopeProvider"/>

    <!--
      Late-binds the entityScopeProvider onto the dynamic-auth
      TokenAcquirer (defined in opennms-config's
      applicationContext-auth.xml). The wiring lives here so it only
      fires when both modules' contexts are loaded together; tests
      that pull in opennms-config without core/mate/model see a
      TokenAcquirer that runs in degraded mode (SCV and env scopes
      only, no per-node placeholder resolution) rather than a
      Spring context that fails to build.

      lazy-init=false and depends-on guarantees the setter runs
      before any consumer of authTokenProvider tries to acquire.
    -->
    <bean id="authTokenAcquirerScopeWiring"
          class="org.springframework.beans.factory.config.MethodInvokingFactoryBean"
          depends-on="entityScopeProvider">
        <property name="targetObject" ref="authTokenAcquirer"/>
        <property name="targetMethod" value="setEntityScopeProvider"/>
        <property name="arguments">
            <list><ref bean="entityScopeProvider"/></list>
        </property>
    </bean>
</beans>
